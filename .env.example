# Help Me Breathe — environment variables
#
# Copy the NAMES from this file into the Vercel dashboard (Settings ->
# Environment Variables). Never copy real values back into this file, and never
# commit a .env — .gitignore already excludes it and must keep doing so.
#
# `node tools/keygen.mjs` prints one 64-character secret per run; run it once each
# for LICENSE_SECRET, TRIAL_PEPPER, DEVICE_PEPPER and CRON_SECRET.
# `GET /api/health` tells you which of these are still unset on a deployment.
# Full explanations live in docs/API.md and docs/private/OWNER_RUNBOOK.md.

# ------------------------------------------------------------------ signing ---

# Signs every entitlement token (and the device-mirror tokens that ride with it), and the email confirmation links /api/subscribe sends. 64 random characters. Rotating it signs every subscriber out of offline use until their next page load and voids any confirmation link not yet clicked.
LICENSE_SECRET=

# ----------------------------------------------------------------- accounts ---

# Supabase project URL, https://<ref>.supabase.co. Also goes into js/config.js (public).
SUPABASE_URL=

# The publishable (anon) key. Public by design; the server copy is used only to call the auth API.
SUPABASE_PUBLISHABLE_KEY=

# The secret (service role) key. Server only. Bypasses row level security. Never in the repo, never in a response.
SUPABASE_SECRET_KEY=

# 64 random characters. HMAC key for the one-way email hash in the trial ledger. Rotating it resets every email trial lock.
TRIAL_PEPPER=

# 64 random characters. HMAC key for the device cookie. Rotating it resets every free-session count and device trial signal.
DEVICE_PEPPER=

# D3. `true` offers the 3-day card-required trial; `false` sells a straight subscription. Read only by api/trial/eligibility.js.
TRIAL_ENABLED=true

# The site's own origin, used to build callback URLs and to check same-origin posts. https://helpmebreath.com in production.
SITE_ORIGIN=https://helpmebreath.com

# ------------------------------------------------------------- payments ---
# Since 2026-09-14 the rail is Stripe under its Managed Payments service, so
# Stripe is the merchant of record (the seller on the receipt; it collects tax
# and owns refunds and disputes). If Stripe refuses Managed Payments for the
# account, checkout CLOSES rather than selling under a model the legal pages
# do not describe. MOR_MANAGED_PAYMENTS=false below is the deliberate switch to
# a plain Stripe checkout, to be flipped only together with the legal copy.

# Which payment rail is live: stripe, paddle or fastspring. Defaults to paddle in code; set it explicitly.
MOR_PROVIDER=stripe

# Stripe: the SECRET key (sk_test_… for test mode, sk_live_… live) — or a restricted key with read/write on Customers, Checkout Sessions, Subscriptions, Invoices, Prices, Tax calculations and Billing portal. Paddle: pdl_live_apikey_… / pdl_sdbx_apikey_…. FastSpring: username:password.
MOR_API_KEY=

# Optional. Overrides the provider's API base URL. Leave empty in production.
MOR_API_BASE=

# Required. Stripe: the webhook endpoint's signing secret (whsec_…) from Developers → Webhooks. Paddle: the notification destination's secret. One per environment: delete the test-mode endpoint at go-live.
MOR_WEBHOOK_SECRET=

# Stripe: the PUBLISHABLE key (pk_test_… / pk_live_…) — public by design; the same value goes into js/config.js as CHECKOUT.clientToken and is only the switch that opens checkout. Paddle: the client-side token (test_… / live_…).
MOR_CLIENT_TOKEN=

# Literally `true` while the keys are test-mode keys, `false` at go-live. Also gates the webhook live-flag check: a test-mode event on a live deployment is recorded as ignored.
MOR_SANDBOX=true

# Price ids. Stripe: price_… (Product catalog → the $10/month and $100/year recurring prices). Paddle: pri_…; FastSpring: the product path.
# Stripe needs only the two paid prices: the 3-day trial is set on the checkout session, not on a second price. Paddle and FastSpring need the _TRIAL prices too.
MOR_PRICE_MONTHLY_TRIAL=
MOR_PRICE_MONTHLY=
MOR_PRICE_YEARLY_TRIAL=
MOR_PRICE_YEARLY=

# Stripe only. Managed Payments (Stripe as merchant of record) is ON unless this is literally `false`. Needs the feature enabled on the account and a product with an eligible tax code (tools/stripe-catalog.mjs). If Stripe refuses it the server sells as a plain checkout with automatic tax and logs the fact — and then the owner is the seller.
MOR_MANAGED_PAYMENTS=true

# FastSpring only: the popup storefront URL.
MOR_STOREFRONT=

# FastSpring only, and only if you prefer two variables to the username:password form of MOR_API_KEY.
MOR_API_USERNAME=
MOR_API_PASSWORD=

# ---------------------------------------------------------- jobs and alerts ---

# Bearer token the two Vercel cron jobs (api/cron/reconcile.js hourly, api/cron/retention.js weekly) must present. 64 random characters.
CRON_SECRET=

# Where orphaned webhooks, forged trials and stuck events are reported.
ALERT_EMAIL=

# -------------------------------------------------------------------- email ---

# Which mailing service is live: resend (default), brevo or mailerlite. Used by the third-session email card and for alert delivery.
EMAIL_PROVIDER=resend

# The mailing service API key. It stays on the server; /api/subscribe is the only thing that ever sees it. Resend: a key with sending AND audiences (contacts) access, because the adapter both sends the confirmation email and creates the contact.
EMAIL_API_KEY=

# Resend: the segment id from the Audience page (Segments -> the segment -> its id). Brevo: the numeric list id (comma separated for several). MailerLite: the group id.
EMAIL_LIST_ID=

# Resend only, required. The sender of the confirmation email, on a domain verified in the mailing service: Help Me Breathe <hello@helpmebreath.com>
EMAIL_FROM=

# Brevo only, required. The numeric id of the double opt-in template that sends the confirmation email. Resend has no templates here: the adapter sends the confirmation itself.
EMAIL_DOI_TEMPLATE_ID=

# Resend and Brevo, required. Where a person lands after clicking the confirmation link: https://helpmebreath.com/pro/thanks?confirmed=1 (the page shows an email-confirmed message, not a purchase)
EMAIL_DOI_REDIRECT_URL=

# Optional. Overrides the mailing service API base URL. Used by the test suite; leave empty in production.
EMAIL_API_BASE=

# --------------------------------------------------------------------- CORS ---

# Optional. Extra origins allowed to call the same-origin endpoints, comma separated. Normally empty: the API and the site share an origin.
ALLOWED_ORIGINS=
