# Help Me Breathe — environment variables
#
# Copy the NAMES from this file into the Vercel dashboard (Settings ->
# Environment Variables). Never copy real values back into this file, and never
# commit a .env — .gitignore already excludes it and must keep doing so.
#
# `node tools/keygen.mjs` prints one 64-character secret per run; run it once each
# for LICENSE_SECRET, TRIAL_PEPPER, DEVICE_PEPPER and CRON_SECRET.
# `GET /api/health` tells you which of these are still unset on a deployment.
# Full explanations live in docs/API.md and docs/private/OWNER_RUNBOOK.md.

# ------------------------------------------------------------------ signing ---

# Signs every entitlement token (and the device-mirror tokens that ride with it). 64 random characters. Rotating it signs every subscriber out of offline use until their next page load.
LICENSE_SECRET=

# ----------------------------------------------------------------- accounts ---

# Supabase project URL, https://<ref>.supabase.co. Also goes into js/config.js (public).
SUPABASE_URL=

# The publishable (anon) key. Public by design; the server copy is used only to call the auth API.
SUPABASE_PUBLISHABLE_KEY=

# The secret (service role) key. Server only. Bypasses row level security. Never in the repo, never in a response.
SUPABASE_SECRET_KEY=

# 64 random characters. HMAC key for the one-way email hash in the trial ledger. Rotating it resets every email trial lock.
TRIAL_PEPPER=

# 64 random characters. HMAC key for the device cookie. Rotating it resets every free-session count and device trial signal.
DEVICE_PEPPER=

# D3. `true` offers the 3-day card-required trial; `false` sells a straight subscription. Read only by api/trial/eligibility.js.
TRIAL_ENABLED=true

# The site's own origin, used to build callback URLs and to check same-origin posts. https://helpmebreath.com in production.
SITE_ORIGIN=https://helpmebreath.com

# --------------------------------------------------- merchant of record (MoR) ---

# Which payment rail is live: paddle (primary) or fastspring (fallback). Defaults to paddle.
MOR_PROVIDER=paddle

# Paddle: an API key beginning pdl_live_apikey_ (or pdl_sdbx_apikey_ for the sandbox). FastSpring: the API credentials as username:password.
MOR_API_KEY=

# Optional. Overrides the provider's API base URL. Leave empty in production; Paddle picks sandbox or live from the shape of MOR_API_KEY.
MOR_API_BASE=

# Required. The signing secret of the webhook notification destination. One per environment: delete the sandbox destination at go-live.
MOR_WEBHOOK_SECRET=

# The client-side checkout token (test_… or live_…). Public by design; the same value goes into js/config.js.
MOR_CLIENT_TOKEN=

# Literally `true` on every sandbox deployment, `false` at go-live. Also gates the webhook live-flag check: a sandbox event on a live deployment is recorded as ignored.
MOR_SANDBOX=true

# Price ids. Paddle: pri_…; FastSpring: the product path. The _TRIAL prices carry the 3-day trial period; the others do not.
MOR_PRICE_MONTHLY_TRIAL=
MOR_PRICE_MONTHLY=
MOR_PRICE_YEARLY_TRIAL=
MOR_PRICE_YEARLY=

# FastSpring only: the popup storefront URL.
MOR_STOREFRONT=

# FastSpring only, and only if you prefer two variables to the username:password form of MOR_API_KEY.
MOR_API_USERNAME=
MOR_API_PASSWORD=

# ---------------------------------------------------------- jobs and alerts ---

# Bearer token the two Vercel cron jobs (api/cron/reconcile.js hourly, api/cron/retention.js weekly) must present. 64 random characters.
CRON_SECRET=

# Where orphaned webhooks, forged trials and stuck events are reported.
ALERT_EMAIL=

# -------------------------------------------------------------------- email ---

# Which mailing service is live: brevo (default) or mailerlite. Used by the third-session email card and for alert delivery.
EMAIL_PROVIDER=brevo

# The mailing service API key. It stays on the server; /api/subscribe is the only thing that ever sees it.
EMAIL_API_KEY=

# Brevo: the numeric list id (comma separated for several). MailerLite: the group id.
EMAIL_LIST_ID=

# Brevo only, required. The numeric id of the double opt-in template that sends the confirmation email.
EMAIL_DOI_TEMPLATE_ID=

# Brevo only, required. Where a person lands after clicking the confirmation link: https://helpmebreath.com/pro/thanks?confirmed=1 (the page shows an email-confirmed message, not a purchase)
EMAIL_DOI_REDIRECT_URL=

# Optional. Overrides the mailing service API base URL. Used by the test suite; leave empty in production.
EMAIL_API_BASE=

# --------------------------------------------------------------------- CORS ---

# Optional. Extra origins allowed to call the same-origin endpoints, comma separated. Normally empty: the API and the site share an origin.
ALLOWED_ORIGINS=
