# Help Me Breathe — environment variables
#
# Copy the NAMES from this file into the Vercel dashboard (Settings ->
# Environment Variables). Never copy real values back into this file, and never
# commit a .env — .gitignore already excludes it and must keep doing so.
#
# `node tools/keygen.mjs` prints a LICENSE_SECRET for you.
# `GET /api/health` tells you which of these are still unset on a deployment.
# Full explanations live in docs/API.md.

# ---------------------------------------------------------------- licensing ---

# Signs every entitlement token. 64 random characters from tools/keygen.mjs. Rotating it invalidates every issued licence token.
LICENSE_SECRET=

# --------------------------------------------------- merchant of record (MoR) ---

# Which payment rail is live: paddle (primary) or fastspring (fallback). Defaults to paddle.
MOR_PROVIDER=paddle

# Paddle: an API key beginning pdl_live_apikey_ (or pdl_sdbx_apikey_ for the sandbox). FastSpring: the API credentials as username:password.
MOR_API_KEY=

# Optional. Overrides the provider's API base URL. Leave empty in production; Paddle picks sandbox or live automatically from the shape of MOR_API_KEY.
MOR_API_BASE=

# Optional today. The signing secret for provider webhooks, reserved for the auto-activation email flow described in the runbook.
MOR_WEBHOOK_SECRET=

# Pro lifetime ($19, $14 founding). Paddle: the pro_ product id and/or the pri_ price ids, comma separated. FastSpring: the product path.
MOR_PRODUCT_LIFETIME=

# Pro monthly, if it is ever offered. Same format as MOR_PRODUCT_LIFETIME. Safe to leave empty.
MOR_PRODUCT_MONTHLY=

# Practitioner ($99/year). Grants the practitioner tier, 25 activations and 1 white-label domain.
MOR_PRODUCT_PRACTITIONER=

# Studio ($199/year). Grants the studio tier, 25 activations and 10 white-label domains.
MOR_PRODUCT_STUDIO=

# Protocol Pack ($19 once). A download, not an app licence: /api/license refuses these keys with an explanation rather than issuing a token.
MOR_PRODUCT_PACK=

# FastSpring only, and only if you prefer two variables to the username:password form of MOR_API_KEY.
MOR_API_USERNAME=

# FastSpring only. The password half of the API credentials.
MOR_API_PASSWORD=

# -------------------------------------------------------------------- email ---

# Which mailing service is live: brevo (default) or mailerlite. Both send the confirmation email themselves.
EMAIL_PROVIDER=brevo

# The mailing service API key. It stays on the server; /api/subscribe is the only thing that ever sees it.
EMAIL_API_KEY=

# Brevo: the numeric list id (comma separated for several). MailerLite: the group id.
EMAIL_LIST_ID=

# Brevo only, required. The numeric id of the double opt-in template that sends the confirmation email.
EMAIL_DOI_TEMPLATE_ID=

# Brevo only, required. Where a person lands after clicking the confirmation link, e.g. https://helpmebreath.com/pro/thanks
EMAIL_DOI_REDIRECT_URL=

# Optional. Overrides the mailing service API base URL. Used by the test suite; leave empty in production.
EMAIL_API_BASE=

# --------------------------------------------------------------------- CORS ---

# Optional. Extra origins allowed to call /api/license and /api/subscribe, comma separated. Normally empty: the API and the site share an origin.
ALLOWED_ORIGINS=
